{
  "manifest_version": 3,
  "name": "Cadastro Automático de Cursos - Refatorado",
  "version": "2.0.0",
  "description": "Automatiza o cadastro de cursos a partir de uma planilha Excel ou CSV com interface moderna e experiência aprimorada",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Abrir Painel Lateral",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/xlsx.full.min.js", "fonts/*", "css/*"],
      "matches": ["<all_urls>"]
    }
  ]
}